{application, alien_mutants, [
    {description, "Mutation testing for Lisp Flavoured Erlang"},
    {vsn, "0.1.0"},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        lfe
    ]},
    {env, [
        %% Registers rebar3_mutate_prv as the rebar3 plugin provider for
        %% this application (checked only when alien_mutants is installed
        %% as a plugin). Harmless when used purely as a library.
        {providers, [rebar3_mutate_prv]}
    ]},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
