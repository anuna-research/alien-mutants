{erl_opts, [debug_info]}.

%% alien_mutants is both the library application this umbrella builds and its
%% own rebar3 plugin (see plugins/alien_mutants). Registering the plugin here
%% makes `rebar3 mutate` available; it never runs automatically as part of any
%% other rebar3 command (SPEC-001 Enable path). The plugin is discovered as a
%% local plugin from plugins/*, which is why the project app itself lives
%% under apps/alien_mutants (rebar3 only discovers local plugins in umbrella
%% projects).
{plugins, [alien_mutants]}.